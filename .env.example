# Copy to .env.local and fill in. Never commit real values.

# Server only (never sent to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser: same values as SUPABASE_URL and SUPABASE_ANON_KEY above.
# These are safe to expose: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
RESEND_API_KEY=
REPORT_FROM_EMAIL=
VFDA_REPORT_EMAIL=
SLACK_WEBHOOK_URL=
