# Copy to .env.local and fill in. Never commit real values.

# Server only (never sent to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser: same values as SUPABASE_URL and SUPABASE_ANON_KEY above.
# These are safe to expose: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=

# Time zone that decides when a training day starts (default America/New_York).
TRAINING_TIME_ZONE=
# Results reports after every attempt (Phase 6). REPORT_FROM_EMAIL must be on a
# domain verified in Resend, e.g. VFDA Reports <reports@yourdomain.com>.
# VFDA_REPORT_EMAIL can list several addresses, separated by commas.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
VFDA_REPORT_EMAIL=
# Slack incoming webhook for VFDA's channel. Keep it secret.
SLACK_WEBHOOK_URL=
