# Copy to .env.local and fill in. Never commit real values.

# Server only (never sent to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser: same values as SUPABASE_URL and SUPABASE_ANON_KEY above.
# These are safe to expose: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
# "mock" grades situational answers by keywords instead of Claude (demos,
# no API credit). Leave empty for live grading. Never use mock for real VAs.
AI_MODE=

# Vercel sends this to the daily recheck cron (vercel.json). Any long random
# string; Vercel adds it automatically when you create it in the project.
CRON_SECRET=

# Time zone that decides when a training day starts (default America/New_York).
TRAINING_TIME_ZONE=
# Results reports after every attempt. REPORT_FROM_EMAIL must be on a domain
# verified in Resend, e.g. VFDA Reports <reports@yourdomain.com>.
# VFDA_REPORT_EMAIL can list several addresses, separated by commas.
# REPORT_REPLY_TO (optional): where replies to a report go.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
VFDA_REPORT_EMAIL=
REPORT_REPLY_TO=
# The app's address for links in reports, e.g. https://your-app.vercel.app
# (on Vercel it defaults to the production URL).
APP_URL=
# Slack incoming webhook for VFDA's channel. Keep it secret.
SLACK_WEBHOOK_URL=
# Leads4Life webhook: after every quiz, one POST per doctor of the office with the
# quiz report's 30-day PDF link; Leads4Life delivers it to the doctor. Keep it secret.
LEADS4LIFE_WEBHOOK_URL=
